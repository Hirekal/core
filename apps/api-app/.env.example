PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hirekal
# When running the API in Docker and Postgres on your host machine:
# DB_HOST=host.docker.internal

# JWT (required)
JWT_SECRET=1234567890plwerqzxcvbnm
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Brevo transactional email — use API v3 key (xkeysib-...), not SMTP key (xsmtpsib-)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Echo one-time codes in API responses (defaults to true when NODE_ENV !== production)
# INCLUDE_EMAIL_CODES=true

# Cloudflare R2 (S3-compatible) — browser uploads directly via presigned PUT URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hirekal-media
R2_PUBLIC_BASE_URL=https://media.hirekal.io
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 API token must have "Object Read & Write" scoped to R2_BUCKET_NAME (Admin Read & Write also works).
# CORS on the bucket: allow CORS_ORIGIN with methods PUT, GET and headers *

# Public apply page base URL (used for shareLink on job API responses)
# Local dev: http://localhost:5173  |  Production: https://apply.hirekal.io
PUBLIC_APPLY_BASE_URL=http://localhost:5173

# Media worker (video transcription) — optional; set to enable AI transcripts on submit
# Results are delivered only via worker callback to POST /api/v1/media-worker-response
MEDIA_WORKER_URL=http://localhost:8000
# MEDIA_WORKER_DISPATCH_TIMEOUT_SECONDS=30
# Cron server — set false on API-only instances to disable scheduled jobs
IS_CRON_SERVER=true

# Stripe / Payments
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel
PAYMENTS_DEFAULT_PROVIDER=STRIPE
