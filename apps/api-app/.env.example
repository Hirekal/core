PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hirekal

# JWT (required)
JWT_SECRET=1234567890plwerqzxcvbnm
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Brevo transactional email — use API v3 key (xkeysib-...), not SMTP key (xsmtpsib-)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Echo one-time codes in API responses (defaults to true when NODE_ENV !== production)
# INCLUDE_EMAIL_CODES=true

# Cloudflare R2 (S3-compatible) — browser uploads directly via presigned PUT URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hirekal-media
R2_PUBLIC_BASE_URL=https://media.hirekal.io
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Required for direct browser → R2 uploads: enable CORS on the bucket (PUT + GET)
# Allowed origins: CORS_ORIGIN value(s), e.g. http://localhost:5173 and your production console URL

# Public apply page base URL (used for shareLink)
PUBLIC_APPLY_BASE_URL=https://apply.hirekal.io