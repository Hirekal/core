WHISPER_MODEL=small
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Temp file cleanup (backup to per-request finally)
TEMP_BASE_DIR=/tmp/media-worker
STALE_TEMP_MAX_AGE_HOURS=6
TEMP_CLEANUP_INTERVAL_HOURS=1

# Optional: POST completed transcript to external API (e.g. NestJS)
# Use host.docker.internal when the API runs on your machine and media-worker runs in Docker
# TRANSCRIPT_CALLBACK_URL=http://host.docker.internal:3000/media-worker-response
