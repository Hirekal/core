{
  "name": "@hirekal/core",
  "version": "0.0.0",
  "private": true,
  "description": "Hirekal — open-source hiring platform monorepo",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:console",
    "dev:api": "npm run start:dev -w @hirekal/api-app",
    "dev:console": "npm run dev -w @hirekal/console-app",
    "build": "npm run build -w @hirekal/api-app && npm run build -w @hirekal/console-app",
    "build:api": "npm run build -w @hirekal/api-app",
    "build:console": "npm run build -w @hirekal/console-app",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7"
  }
}
