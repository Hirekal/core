{
  "name": "@hirekal/core",
  "version": "1.0.0",
  "private": true,
  "description": "Hirekal — open-source hiring platform monorepo",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:console",
    "dev:api": "nest start api-app --watch",
    "dev:console": "npm run dev -w @hirekal/console-app",
    "build": "npm run build:api && npm run build:console",
    "build:api": "nest build api-app",
    "build:console": "npm run build -w @hirekal/console-app",
    "start:prod:api": "npm run build:api && node dist/apps/api-app/main.js",
    "start:api": "nest start api-app",
    "start:debug:api": "nest start api-app --debug --watch",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^11.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "typeorm": "0.3.28"
  }
}
